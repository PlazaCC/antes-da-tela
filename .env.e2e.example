# Playwright e2e — copy to .env.e2e (gitignored) and fill in. See e2e/README.md.
# The app's own variables (Supabase, Clerk, AWS, Sentry DSN, PostHog, Resend…) come
# from .env.local / .env as usual; this file holds only what the tests need.

# Required: confirms the DEV database. Must equal NEXT_PUBLIC_SUPABASE_URL of the
# dev project, or the suite refuses to run (it creates and deletes test data).
E2E_SUPABASE_URL=

# Optional: run against an already deployed URL (e.g. https://dev.antesdatela.com.br)
# instead of starting `yarn dev`.
E2E_BASE_URL=

# Optional: provider-side confirmation in e2e/integrations.spec.ts.
# Sentry personal token (User Settings → Personal Tokens) with event:read,
# project:read, org:read; slugs of the organization and the DEV project.
E2E_SENTRY_API_TOKEN=
E2E_SENTRY_API_URL=https://sentry.io
SENTRY_ORG=
SENTRY_PROJECT=

# Resend "Full access" key (the app's keys are sending-only) to confirm delivery.
E2E_RESEND_API_KEY=
