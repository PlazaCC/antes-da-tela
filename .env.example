# Corepack Vercel https://vercel.com/docs/builds/configure-a-build#corepack
ENABLE_EXPERIMENTAL_COREPACK=1

# App URL (used for metadataBase / OG links)
NEXT_PUBLIC_APP_URL=https://www.antesdatela.com.br

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Privileged operations: Clerk user sync (webhook) and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — https://dashboard.clerk.com → API keys / Webhooks
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the webhook pointing at /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/login

# Posthog
NEXT_PUBLIC_POSTHOG_TOKEN=your-posthog-token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend
RESEND_API_KEY=your-resend-api-key
TEST_RESEND_TO=your-test-email

# Sentry
# `SENTRY_AUTH_TOKEN` is used by the Sentry build plugin (source map upload).
# Keep it secret and set it in CI (Vercel/Netlify) — do not commit the token.
SENTRY_AUTH_TOKEN=your-sentry-api-key
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Public Sentry variables for client-side SDK (optional but required to capture browser errors)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false

# AWS S3 — used for file uploads (scripts, audio, covers, banners, pitch decks)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Base public URL for S3 assets — either CloudFront or https://{bucket}.s3.{region}.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL=

