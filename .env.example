# ─────────────────────────────────────────────────────────────────────────────
# Antes da Tela — environment variables
#
# Where each variable lives (see docs/DEPLOY.md):
#   [app]     your machine (.env / .env.local) AND Vercel (Production + Preview→dev)
#   [local]   your machine only
#   [github]  GitHub → Settings → Secrets and variables → Actions (or an environment)
#
# Values differ per environment: production uses the production services,
# the `dev` branch / your machine use the dev ones. Never put production keys
# in a local file. `.env.local` overrides `.env`.
#
# Vercel: NEXT_PUBLIC_* must NOT be marked "Sensitive" (the GitHub Actions
# build reads variables with `vercel pull`, which returns Sensitive ones empty).
# E2E-only settings live in .env.e2e (see .env.e2e.example).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# [app] Public URL: metadata, Open Graph, e-mail links.
#   prod: https://www.antesdatela.com · dev: https://dev.antesdatela.com.br · local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [app] Vercel build: use the Yarn version pinned in package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
# [app] 1 = expose /development tools outside local dev (dev only; never in production).
EXPOSE_DEVELOPER_ROUTER=

# ── Supabase ─────────────────────────────────────────────────────────────────
# [app] Project Settings → Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [app] Server only (Sensitive). Privileged ops: Clerk user sync, account deletion, notifications.
SUPABASE_SERVICE_ROLE_KEY=

# [local, github] Migrations only — never needed by the running app.
#   Connect → Session pooler (port 5432) works everywhere (GitHub runners have no IPv6).
#   Locally: yarn db:migrate:verbose · CI: secret DATABASE_URL_UNPOOLED per GitHub environment.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
# [app] Configure → API keys. dev: Development instance (pk_test_/sk_test_) · prod: pk_live_/sk_live_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# [app] Configure → Webhooks → endpoint https://<domain>/api/webhooks/clerk (events user.*). Not needed locally.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# ── AWS S3 (uploads) ─────────────────────────────────────────────────────────
# [app] Bucket + IAM user per environment (the dev user only reaches the dev bucket).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# [app] https://<bucket>.s3.<region>.amazonaws.com (or the CloudFront URL).
NEXT_PUBLIC_S3_PUBLIC_URL=

# ── Sentry (errors) ──────────────────────────────────────────────────────────
# [app] One Sentry project per environment: Settings → Projects → <project> → Client Keys (DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# [app] production | dev
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
# [github] Source-map upload during the build: secret SENTRY_AUTH_TOKEN (organization token),
#   variables SENTRY_ORG and SENTRY_PROJECT (per environment). Optional locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── PostHog (analytics) ──────────────────────────────────────────────────────
# [app] Project settings → Project token (phc_…). One project per environment, US region
#   (the /ingest rewrite in next.config.ts points to the US cloud).
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Resend (e-mail) ──────────────────────────────────────────────────────────
# [app] API Keys (Sending access, domain antesdatela.com). Without both, e-mails are skipped.
RESEND_API_KEY=
# [app] prod: "Antes da Tela <nao-responda@antesdatela.com>" · dev: "Antes da Tela (dev) <nao-responda@antesdatela.com>"
RESEND_FROM_EMAIL=
# [local] Recipient of the test e-mail in /development/integrations.
TEST_RESEND_TO=
